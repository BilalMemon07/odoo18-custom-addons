<odoo>
    <record id="view_partner_form_geo_location_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.geo.location.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='city']" position="after">            
                <field name="type_customer"/>
                <field name="geo_town_id"/>
                <field name="geo_territory_id" readonly="1"/>
                <field name="geo_zone_id" readonly="1"/>
                <field name="geo_region_id" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>