<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_splendid_connection_list" model="ir.ui.view">
        <field name="name">splendid.account.connection.list</field>
        <field name="model">splendid.account.connection</field>
        <field name="arch" type="xml">
            <list string="Splendid Connections">
                <field name="name"/>
                <field name="tenant"/>
                <field name="branch"/>
                <field name="company_id"/>
                <field name="active"/>
                <field name="last_master_sync"/>
                <field name="products_fetched_count"/>
                <field name="customers_fetched_count"/>
                <field name="vendors_fetched_count"/>
            </list>
        </field>
    </record>

    <record id="view_splendid_connection_form" model="ir.ui.view">
        <field name="name">splendid.account.connection.form</field>
        <field name="model">splendid.account.connection</field>
        <field name="arch" type="xml">
            <form string="Splendid Connection">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_sync_masters" type="object" string="Sync Master Data" class="btn-primary"
                            confirm="This will sync Chart of Accounts, Customers, Vendors, Products, Warehouses, Bank Accounts and Taxes only."/>
                    <button name="action_sync_sales_process" type="object" string="Sync Sales Process" class="btn-secondary"
                            confirm="This will fetch sale invoices by date range, get each invoice by ID, create/confirm sale orders, create invoices, sale returns, return transfers, credit notes and customer payments."/>
                    <button name="action_sync_purchase_process" type="object" string="Sync Purchase Process" class="btn-secondary"
                            confirm="This will fetch purchase invoices with page=1 and size=150, get each invoice by ID, create vendor bills/receipts, purchase returns, return transfers and vendor payments."/>
                    <button name="action_sync_journal_entries" type="object" string="Sync Journal Entries" class="btn-secondary"
                            confirm="This will migrate Splendid JournalEntries using the current From/To Date, GET each record by ID, map exact GL accounts, and create balanced Odoo journal entries. Posting follows the Journal Entries option."/>
                    <button name="action_sync_expenses" type="object" string="Sync Expenses" class="btn-secondary"
                            confirm="This will GET the Splendid Expenses list, skip status 30/void rows before detail calls, GET every remaining Expenses/{id}, and create exact balanced Odoo journal entries from the source accounts."/>
                    <button name="action_sync_job_orders" type="object" string="Sync Job Orders" class="btn-secondary"
                            confirm="This will fetch Splendid Job Orders, create one dedicated BoM per Job Order, create an Odoo Manufacturing Order, and import Job Order expenses as Odoo extra manufacturing cost. Component cost fields from Splendid are still ignored."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group string="Destination Company">
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <group string="API Access">
                            <field name="base_url" placeholder="https://app.splendidaccounts.com"/>
                            <field name="tenant"/>
                            <field name="branch"/>
                            <field name="api_key" password="True"/>
                            <field name="api_secret" password="True"/>
                            <field name="app_id" password="True"/>
                            <field name="verify_ssl"/>
                            <field name="timeout"/>
                            <field name="page_size"/>
                        </group>
                        <group string="Default Accounts / Fallbacks">
                            <field name="default_receivable_account_id"/>
                            <field name="default_payable_account_id"/>
                            <field name="default_income_account_id"/>
                            <field name="default_expense_account_id"/>
                            <field name="default_stock_account_id"/>
                            <field name="sale_journal_id"/>
                            <field name="purchase_journal_id"/>
                            <field name="bank_journal_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Master Data Sync">
                            <group string="Only Master Data is Synced in this Version">
                                <button name="action_sync_masters" type="object" string="Sync Master Data" class="btn-primary"/>
                                <field name="last_master_sync" readonly="1"/>
                            </group>
                            <group string="Included Splendid Data">
                                <separator string="Chart of Accounts, Customers, Vendors, Products, Warehouses, Bank Accounts and Taxes"/>
                            </group>
                            <group string="Last Sync Dates">
                                <group>
                                    <field name="last_chart_accounts_sync" readonly="1"/>
                                    <field name="last_customers_sync" readonly="1"/>
                                    <field name="last_vendors_sync" readonly="1"/>
                                    <field name="last_products_sync" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_get_products_sync" readonly="1"/>
                                    <field name="last_warehouses_sync" readonly="1"/>
                                    <field name="last_bank_accounts_sync" readonly="1"/>
                                    <field name="last_taxes_sync" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Sales Process Sync">
                            <group string="Date Range">
                                <field name="sync_from_date"/>
                                <field name="sync_to_date"/>
                            </group>
                            <group string="Sales Sync Controls">
                                <button name="action_sync_sales_process" type="object" string="Sync Sales Process" class="btn-primary"/>
                                <button name="action_sync_sale_invoices" type="object" string="Sync Sale Invoices" class="btn-secondary"/>
                                <button name="action_sync_sale_returns" type="object" string="Sync Sale Returns" class="btn-secondary"/>
                                <button name="action_sync_customer_payments" type="object" string="Sync Customer Payments" class="btn-secondary"/>
                                <button name="action_sync_customer_refunds" type="object" string="Sync Customer Refunds" class="btn-secondary"/>
                                <button name="action_reconcile_customer_settlements" type="object" string="Reconcile Customer Settlements" class="btn-secondary"
                                        confirm="This will fetch Splendid CustomerSettlements, GET every settlement by ID, and reconcile the exact customerSettlementDetails adjustedAmount between the referenced CustomerPayment / CustomerRefund and SaleInvoice / SaleReturn records. Draft referenced documents will be posted. No write-off will be created and existing unrelated reconciliations will not be removed."/>
                            </group>
                            <group string="Sales Options">
                                <group>
                                    <field name="auto_confirm_sale_orders"/>
                                    <field name="auto_create_sale_deliveries"/>
                                    <field name="auto_validate_sale_deliveries"/>
                                    <field name="auto_post_sale_invoices"/>
                                </group>
                                <group>
                                    <field name="auto_create_return_transfers"/>
                                    <field name="auto_validate_return_transfers"/>
                                    <field name="auto_post_customer_payments"/>
                                    <field name="auto_reconcile_customer_payments"/>
                                    <field name="auto_post_customer_refunds"/>
                                    <field name="auto_reconcile_customer_refunds"/>
                                </group>
                            </group>
                            <group string="Last Sales Sync Dates">
                                <field name="last_sales_process_sync" readonly="1"/>
                                <field name="last_sale_invoices_sync" readonly="1"/>
                                <field name="last_sale_returns_sync" readonly="1"/>
                                <field name="last_customer_payments_sync" readonly="1"/>
                                <field name="last_customer_refunds_sync" readonly="1"/>
                            </group>
                        </page>



                        <page string="Purchase Process Sync">
                            <group string="Date Range">
                                <field name="sync_from_date"/>
                                <field name="sync_to_date"/>
                            </group>
                            <group string="Purchase Sync Controls">
                                <button name="action_sync_purchase_process" type="object" string="Sync Purchase Process" class="btn-primary"/>
                                <button name="action_sync_purchase_invoices" type="object" string="Sync Purchase Invoices / Vendor Bills" class="btn-secondary"/>
                                <button name="action_sync_purchase_returns" type="object" string="Sync Purchase Returns" class="btn-secondary"/>
                                <button name="action_sync_vendor_payments" type="object" string="Sync Vendor Payments" class="btn-secondary"/>
                                <button name="action_reconcile_purchase_settlements" type="object" string="Reconcile Splendid Settlements" class="btn-secondary"
                                        confirm="This will fetch Splendid VendorSettlements, GET every settlement by ID, and reconcile the exact vendorSettlementDetails adjustedAmount between the referenced VendorPayment / PurchaseReturn and PurchaseInvoice records. Draft referenced documents will be posted. No write-off will be created."/>
                            </group>
                            <group string="Purchase Options">
                                <group>
                                    <field name="auto_post_purchase_bills"/>
                                    <field name="auto_create_purchase_receipts"/>
                                    <field name="auto_validate_purchase_receipts"/>
                                </group>
                                <group>
                                    <field name="auto_create_purchase_return_transfers"/>
                                    <field name="auto_validate_purchase_return_transfers"/>
                                    <field name="auto_post_vendor_payments"/>
                                    <field name="auto_reconcile_vendor_payments"/>
                                </group>
                            </group>
                            <group string="Last Purchase Sync Dates">
                                <field name="last_purchase_process_sync" readonly="1"/>
                                <field name="last_purchase_invoices_sync" readonly="1"/>
                                <field name="last_purchase_returns_sync" readonly="1"/>
                                <field name="last_vendor_payments_sync" readonly="1"/>
                            </group>
                        </page>

                        <page string="Journal Entries Migration">
                            <group string="Date Range">
                                <field name="sync_from_date"/>
                                <field name="sync_to_date"/>
                            </group>
                            <group string="Bulk Migration">
                                <button name="action_sync_journal_entries" type="object" string="Sync Journal Entries" class="btn-primary"
                                        confirm="This will GET JournalEntries, skip status 30/void rows before detail calls, then GET JournalEntries/{id} for each remaining record and create/update exact balanced Odoo journal entries. Posted Odoo entries are never silently rewritten."/>
                                <field name="journal_entry_journal_id"/>
                                <field name="auto_post_journal_entries"/>
                                <field name="last_journal_entries_sync" readonly="1"/>
                            </group>
                            <group string="Import One Journal Entry by ID">
                                <field name="journal_entry_external_id" placeholder="e.g. 1103816"/>
                                <button name="action_sync_journal_entry_by_id" type="object" string="GET /JournalEntries/{id} and Import" class="btn-secondary"/>
                            </group>
                            <group string="Latest Journal Entry Sync Counts">
                                <field name="journal_entries_fetched_count" readonly="1"/>
                                <field name="journal_entries_imported_count" readonly="1"/>
                                <field name="journal_entries_failed_count" readonly="1"/>
                            </group>
                            <group string="Accounting Safety">
                                <separator string="Every journalEntryDetails line uses the exact Splendid accountId/account code. Missing accounts are fetched from Splendid Accounts; no fallback GL account is guessed. The entry must balance before Odoo will create it. Foreign-currency entries are stopped for review rather than guessed."/>
                            </group>
                        </page>

                        <page string="Expenses Migration">
                            <group string="Date Range">
                                <field name="sync_from_date"/>
                                <field name="sync_to_date"/>
                            </group>
                            <group string="Bulk Migration">
                                <button name="action_sync_expenses" type="object" string="Sync Expenses" class="btn-primary"
                                        confirm="This will GET /Expenses first, skip status 30 and void rows before any ID-detail request, then GET /Expenses/{id} for each remaining record and create/update a balanced Odoo journal entry."/>
                                <field name="expense_journal_id"/>
                                <field name="auto_post_expenses"/>
                                <field name="last_expenses_sync" readonly="1"/>
                            </group>
                            <group string="Import One Expense by ID">
                                <field name="expense_external_id" placeholder="e.g. 600438"/>
                                <button name="action_sync_expense_by_id" type="object" string="GET /Expenses/{id} and Import" class="btn-secondary"/>
                            </group>
                            <group string="Latest Expense Sync Counts">
                                <field name="expenses_fetched_count" readonly="1"/>
                                <field name="expenses_imported_count" readonly="1"/>
                                <field name="expenses_failed_count" readonly="1"/>
                            </group>
                            <group string="Accounting Rule">
                                <separator string="Each expenseDetails account is debited from the exact Splendid accountId/account code, and the top-level Expense account is credited for netAmount. Tax lines use exact Splendid purchase/input tax accounts when tax exists. No balancing or fallback GL line is guessed."/>
                            </group>
                        </page>

                        <page string="Manufacturing / Job Orders">
                            <group string="Date Range">
                                <field name="sync_from_date"/>
                                <field name="sync_to_date"/>
                            </group>
                            <group string="Job Order Sync">
                                <button name="action_sync_job_orders" type="object" string="Sync Job Orders" class="btn-primary"
                                        confirm="Each Splendid Job Order uses its own dedicated BoM. Component quantities come from Splendid. Splendid component cost/totalCost are ignored. Each mapped jobOrderExpense becomes a fixed-cost Odoo Manufacturing Work Order so the cost enters native Work Center costing. No separate custom Job Order expense Journal Entry is created."/>
                                <field name="auto_confirm_job_orders"/>
                                <field name="last_manufacturing_sync" readonly="1" string="Last Job Order Sync"/>
                            </group>
                            <group string="Costing Rule">
                                <separator string="Odoo Costing: component quantities come from Splendid, component prices come from Odoo, and each jobOrderExpense becomes a fixed-cost Manufacturing Work Order. Odoo finished-product valuation therefore uses components + normal Work Orders + Splendid fixed-cost Work Orders. The old custom Job Order expense Journal Entry/Extra Unit Cost mechanism is disabled."/>
                            </group>
                            <group string="Latest Job Order Sync Counts">
                                <field name="job_orders_fetched_count" readonly="1"/>
                                <field name="job_orders_imported_count" readonly="1"/>
                                <field name="job_orders_failed_count" readonly="1"/>
                            </group>
                        </page>

                        <page string="Sync Counts Verification">
                            <group string="Counts from Latest Sync">
                                <group string="Chart of Accounts">
                                    <field name="chart_accounts_fetched_count" readonly="1"/>
                                    <field name="chart_accounts_imported_count" readonly="1"/>
                                    <field name="chart_accounts_failed_count" readonly="1"/>
                                </group>
                                <group string="Customers">
                                    <field name="customers_fetched_count" readonly="1"/>
                                    <field name="customers_imported_count" readonly="1"/>
                                    <field name="customers_failed_count" readonly="1"/>
                                </group>
                                <group string="Vendors">
                                    <field name="vendors_fetched_count" readonly="1"/>
                                    <field name="vendors_imported_count" readonly="1"/>
                                    <field name="vendors_failed_count" readonly="1"/>
                                </group>
                                <group string="Products">
                                    <field name="products_fetched_count" readonly="1"/>
                                    <field name="products_imported_count" readonly="1"/>
                                    <field name="products_failed_count" readonly="1"/>
                                </group>
                                <group string="Warehouses">
                                    <field name="warehouses_fetched_count" readonly="1"/>
                                    <field name="warehouses_imported_count" readonly="1"/>
                                    <field name="warehouses_failed_count" readonly="1"/>
                                </group>
                                <group string="Bank Accounts">
                                    <field name="bank_accounts_fetched_count" readonly="1"/>
                                    <field name="bank_accounts_imported_count" readonly="1"/>
                                    <field name="bank_accounts_failed_count" readonly="1"/>
                                </group>
                                <group string="Taxes">
                                    <field name="taxes_fetched_count" readonly="1"/>
                                    <field name="taxes_imported_count" readonly="1"/>
                                    <field name="taxes_failed_count" readonly="1"/>
                                </group>
                                <group string="Journal Entries">
                                    <field name="journal_entries_fetched_count" readonly="1"/>
                                    <field name="journal_entries_imported_count" readonly="1"/>
                                    <field name="journal_entries_failed_count" readonly="1"/>
                                </group>
                                <group string="Expenses">
                                    <field name="expenses_fetched_count" readonly="1"/>
                                    <field name="expenses_imported_count" readonly="1"/>
                                    <field name="expenses_failed_count" readonly="1"/>
                                </group>
                                <group string="Job Orders / Manufacturing">
                                    <field name="job_orders_fetched_count" readonly="1"/>
                                    <field name="job_orders_imported_count" readonly="1"/>
                                    <field name="job_orders_failed_count" readonly="1"/>
                                </group>
                                <group string="Sale Invoices">
                                    <field name="sale_invoices_fetched_count" readonly="1"/>
                                    <field name="sale_invoices_imported_count" readonly="1"/>
                                    <field name="sale_invoices_failed_count" readonly="1"/>
                                </group>
                                <group string="Sale Returns">
                                    <field name="sale_returns_fetched_count" readonly="1"/>
                                    <field name="sale_returns_imported_count" readonly="1"/>
                                    <field name="sale_returns_failed_count" readonly="1"/>
                                </group>
                                <group string="Customer Payments">
                                    <field name="customer_payments_fetched_count" readonly="1"/>
                                    <field name="customer_payments_imported_count" readonly="1"/>
                                    <field name="customer_payments_failed_count" readonly="1"/>
                                </group>
                                <group string="Customer Refunds">
                                    <field name="customer_refunds_fetched_count" readonly="1"/>
                                    <field name="customer_refunds_imported_count" readonly="1"/>
                                    <field name="customer_refunds_failed_count" readonly="1"/>
                                </group>
                                <group string="Purchase Invoices / Vendor Bills">
                                    <field name="purchase_invoices_fetched_count" readonly="1"/>
                                    <field name="purchase_invoices_imported_count" readonly="1"/>
                                    <field name="purchase_invoices_failed_count" readonly="1"/>
                                </group>
                                <group string="Purchase Returns">
                                    <field name="purchase_returns_fetched_count" readonly="1"/>
                                    <field name="purchase_returns_imported_count" readonly="1"/>
                                    <field name="purchase_returns_failed_count" readonly="1"/>
                                </group>
                                <group string="Vendor Payments">
                                    <field name="vendor_payments_fetched_count" readonly="1"/>
                                    <field name="vendor_payments_imported_count" readonly="1"/>
                                    <field name="vendor_payments_failed_count" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Mappings">
                            <field name="mapping_ids" readonly="1">
                                <list>
                                    <field name="company_id"/>
                                    <field name="external_model"/>
                                    <field name="external_id"/>
                                    <field name="external_name"/>
                                    <field name="odoo_model"/>
                                    <field name="res_id"/>
                                    <field name="last_sync_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Logs">
                            <field name="log_ids" readonly="1">
                                <list decoration-danger="state == 'error'" decoration-success="state == 'success'" decoration-muted="state == 'skipped'">
                                    <field name="create_date"/>
                                    <field name="sync_type"/>
                                    <field name="external_id"/>
                                    <field name="state"/>
                                    <field name="message"/>
                                    <field name="odoo_model"/>
                                    <field name="res_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_splendid_log_list" model="ir.ui.view">
        <field name="name">splendid.sync.log.list</field>
        <field name="model">splendid.sync.log</field>
        <field name="arch" type="xml">
            <list string="Splendid Logs" decoration-danger="state == 'error'" decoration-success="state == 'success'" decoration-muted="state == 'skipped'">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="company_id"/>
                <field name="sync_type"/>
                <field name="external_id"/>
                <field name="state"/>
                <field name="message"/>
                <field name="odoo_model"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <record id="view_splendid_log_form" model="ir.ui.view">
        <field name="name">splendid.sync.log.form</field>
        <field name="model">splendid.sync.log</field>
        <field name="arch" type="xml">
            <form string="Splendid Log">
                <sheet>
                    <group>
                        <field name="connection_id" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                        <field name="sync_type" readonly="1"/>
                        <field name="external_id" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="message" readonly="1"/>
                        <field name="odoo_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" readonly="1" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_splendid_map_list" model="ir.ui.view">
        <field name="name">splendid.sync.map.list</field>
        <field name="model">splendid.sync.map</field>
        <field name="arch" type="xml">
            <list string="Splendid Mappings">
                <field name="connection_id"/>
                <field name="company_id"/>
                <field name="external_model"/>
                <field name="external_id"/>
                <field name="external_name"/>
                <field name="odoo_model"/>
                <field name="res_id"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="action_splendid_connection" model="ir.actions.act_window">
        <field name="name">Splendid Connections</field>
        <field name="res_model">splendid.account.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_splendid_logs" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">splendid.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_splendid_mappings" model="ir.actions.act_window">
        <field name="name">External ID Mappings</field>
        <field name="res_model">splendid.sync.map</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_splendid_root" name="Splendid Accounts" sequence="50" groups="base.group_system"/>
    <menuitem id="menu_splendid_connections" name="Connections" parent="menu_splendid_root" action="action_splendid_connection" sequence="10"/>
    <menuitem id="menu_splendid_logs" name="Sync Logs" parent="menu_splendid_root" action="action_splendid_logs" sequence="20"/>
    <menuitem id="menu_splendid_mappings" name="Mappings" parent="menu_splendid_root" action="action_splendid_mappings" sequence="30"/>
</odoo>
