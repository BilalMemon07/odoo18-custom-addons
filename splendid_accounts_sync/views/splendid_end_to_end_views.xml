<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Keep the previous inherited view XML ID, but disable it so old module-wise/transaction buttons disappear on upgrade. -->
    <record id="view_splendid_connection_form_end_to_end" model="ir.ui.view">
        <field name="name">splendid.account.connection.form.end.to.end.disabled</field>
        <field name="model">splendid.account.connection</field>
        <field name="inherit_id" ref="splendid_accounts_sync.view_splendid_connection_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes"/>
        </field>
    </record>
</odoo>
