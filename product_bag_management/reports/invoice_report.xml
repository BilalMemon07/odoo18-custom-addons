<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="invoice_report_bag_weight_quantity" inherit_id="account.report_invoice_document">
        <!-- For companies without Use Custom Invoice, show invoice quantity in
             the bag configuration's weight UoM (normally KG). Products without
             a bag configuration retain Odoo's normal quantity display. -->
        <xpath expr="//td[@name='td_quantity']" position="replace">
            <td name="td_quantity" class="text-end text-nowrap">
                <t t-if="not o.company_id.use_custom_invoice and line.bag_uom_id">
                    <span t-field="line.bag_weight_qty"/>
                    <span t-field="line.bag_uom_id"/>
                </t>
                <t t-else="">
                    <span t-field="line.quantity" class="text-nowrap"/>
                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                    <span t-if="line.product_uom_id != line.product_id.uom_id"
                          groups="uom.group_uom"
                          class="text-muted small">
                        <br/>
                        <t t-set="product_uom_qty"
                           t-value="line.product_uom_id._compute_quantity(line.quantity, line.product_id.uom_id)"/>
                        <span t-out="product_uom_qty"
                              t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                        <span t-field="line.product_id.uom_id"/>
                    </span>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
