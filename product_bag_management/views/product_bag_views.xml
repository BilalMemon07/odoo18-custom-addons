<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Bag Configuration -->
    <record id="view_product_bag_tree" model="ir.ui.view">
        <field name="name">product.bag.config.list</field>
        <field name="model">product.bag.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="weight_per_bag"/>
                <field name="uom_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_product_bag_form" model="ir.ui.view">
        <field name="name">product.bag.config.form</field>
        <field name="model">product.bag.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="weight_per_bag"/>
                        <field name="uom_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_bag_config" model="ir.actions.act_window">
        <field name="name">Bag Configuration</field>
        <field name="res_model">product.bag.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_bag_config"
              name="Bag Configuration"
              parent="stock.menu_stock_inventory_control"
              action="action_product_bag_config"
              sequence="25"/>

    <!-- Sale Order -->
    <record id="sale_order_form_inherit_bags" model="ir.ui.view">
        <field name="name">sale.order.form.bags</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='company_id'])[1]" position="after">
                <field name="company_use_custom_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']//list//field[@name='product_uom_qty']" position="after">
                <field name="bag_qty"
                       column_invisible="parent.company_use_custom_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order -->
    <record id="purchase_order_form_inherit_bags" model="ir.ui.view">
        <field name="name">purchase.order.form.bags</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='company_id'])[1]" position="after">
                <field name="company_use_custom_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_qty']" position="after">
                <field name="bag_qty"
                       readonly="1"
                       column_invisible="parent.company_use_custom_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- Customer Invoice / Vendor Bill -->
    <record id="account_move_form_inherit_bags" model="ir.ui.view">
        <field name="name">account.move.form.bags</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='company_id'])[1]" position="after">
                <field name="company_use_custom_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                <field name="bag_qty"
                       readonly="parent.state != 'draft'"
                       column_invisible="parent.company_use_custom_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- Inventory On Hand -->
    <record id="stock_quant_list_inherit_bags" model="ir.ui.view">
        <field name="name">stock.quant.list.bags</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="after">
                <field name="bag_qty" optional="show" string="On Hand (Bags)"/>
            </xpath>
        </field>
    </record>
</odoo>
