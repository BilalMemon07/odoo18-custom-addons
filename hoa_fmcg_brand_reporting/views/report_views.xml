                <filter string="Sales Team" name="group_team" context="{'group_by': 'team_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_fmcg_brand_sales_report" model="ir.actions.act_window">
        <field name="name">Brand Sales &amp; Revenue</field>
        <field name="res_model">fmcg.brand.sales.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_fmcg_brand_sales_report_search"/>
    </record>
    <menuitem id="menu_fmcg_brand_sales_report" name="Brand Sales &amp; Revenue" parent="menu_fmcg_reports" action="action_fmcg_brand_sales_report" sequence="20"/>

