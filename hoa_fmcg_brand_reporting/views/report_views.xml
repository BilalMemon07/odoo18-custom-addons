<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Cost vs Revenue -->
    <record id="view_fmcg_cost_revenue_report_list" model="ir.ui.view">
        <field name="name">fmcg.cost.revenue.report.list</field>
        <field name="model">fmcg.cost.revenue.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="team_id"/>
                <field name="fmcg_city_id" string="Town/City"/>
                <field name="fmcg_territory_id"/>
                <field name="fmcg_zone_id"/>
                <field name="fmcg_channel_id"/>
                <field name="fmcg_brand_id"/>
                <field name="salesperson_id"/>
                <field name="revenue" sum="Revenue"/>
                <field name="cogs" sum="COGS"/>
                <field name="gross_margin" sum="Gross Margin"/>
                <field name="allocated_expenses" sum="Allocated Expenses"/>
                <field name="net_margin" sum="Net Margin"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_fmcg_cost_revenue_report_pivot" model="ir.ui.view">
        <field name="name">fmcg.cost.revenue.report.pivot</field>
        <field name="model">fmcg.cost.revenue.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="team_id" type="row"/>
                <field name="fmcg_city_id" type="row"/>
                <field name="fmcg_territory_id" type="row"/>
                <field name="fmcg_zone_id" type="row"/>
                <field name="fmcg_channel_id" type="col"/>
                <field name="revenue" type="measure"/>
                <field name="cogs" type="measure"/>
                <field name="gross_margin" type="measure"/>
                <field name="allocated_expenses" type="measure"/>
                <field name="net_margin" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_fmcg_cost_revenue_report_graph" model="ir.ui.view">
        <field name="name">fmcg.cost.revenue.report.graph</field>
        <field name="model">fmcg.cost.revenue.report</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="team_id"/>
                <field name="revenue" type="measure"/>
                <field name="cogs" type="measure"/>
                <field name="net_margin" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_fmcg_cost_revenue_report_search" model="ir.ui.view">
        <field name="name">fmcg.cost.revenue.report.search</field>
        <field name="model">fmcg.cost.revenue.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
                <field name="fmcg_brand_id"/>
                <field name="fmcg_region_id"/>
                <field name="fmcg_city_id" string="Town/City"/>
                <field name="fmcg_territory_id"/>
                <field name="fmcg_zone_id"/>
                <field name="fmcg_channel_id"/>
                <field name="team_id"/>
                <field name="salesperson_id"/>
                <filter string="Brand" name="group_brand" context="{'group_by': 'fmcg_brand_id'}"/>
                <filter string="Sales Team" name="group_team" context="{'group_by': 'team_id'}"/>
                <filter string="Town/City" name="group_city" context="{'group_by': 'fmcg_city_id'}"/>
                <filter string="Territory" name="group_territory" context="{'group_by': 'fmcg_territory_id'}"/>
                <filter string="Zone" name="group_zone" context="{'group_by': 'fmcg_zone_id'}"/>
                <filter string="Channel" name="group_channel" context="{'group_by': 'fmcg_channel_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_fmcg_cost_revenue_report" model="ir.actions.act_window">
        <field name="name">Cost vs Revenue</field>
        <field name="res_model">fmcg.cost.revenue.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_fmcg_cost_revenue_report_search"/>
    </record>
    <menuitem id="menu_fmcg_cost_revenue_report" name="Cost vs Revenue" parent="menu_fmcg_reports" action="action_fmcg_cost_revenue_report" sequence="10"/>

    <!-- Brand Sales -->
