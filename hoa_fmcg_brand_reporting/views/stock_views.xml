<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_form_fmcg" model="ir.ui.view">
        <field name="name">stock.picking.form.fmcg</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="show_fmcg_fields" invisible="1"/>
                <field name="fmcg_region_id" invisible="not show_fmcg_fields"/>
                <field name="fmcg_zone_id" invisible="not show_fmcg_fields" domain="[('region_id', '=', fmcg_region_id)]"/>
                <field name="fmcg_territory_id" invisible="not show_fmcg_fields" domain="[('zone_id', '=', fmcg_zone_id)]"/>
                <field name="fmcg_city_id" invisible="not show_fmcg_fields" domain="[('territory_id', '=', fmcg_territory_id)]"/>
                <field name="fmcg_channel_id" invisible="not show_fmcg_fields"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_id']" position="after">
                <field name="fmcg_brand_id" optional="show" column_invisible="not parent.show_fmcg_fields"/>
            </xpath>
        </field>
    </record>
</odoo>
